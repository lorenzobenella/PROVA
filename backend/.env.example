# Strava API app credentials — create one at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/api/auth/strava/callback

# Garmin Connect credentials (used only to sign in via the unofficial
# garminconnect/garth client; never sent anywhere else, stored only in
# your local SQLite database).
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Random string used to sign local session cookies.
SECRET_KEY=change-me

# Where the local SQLite database lives.
DATABASE_URL=sqlite:///./data/app.db
